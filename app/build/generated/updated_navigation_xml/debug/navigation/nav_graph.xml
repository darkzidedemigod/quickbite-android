<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/homeFragment" >
<fragment
    android:id="@+id/homeFragment"
    android:name="com.quickbite.app.ui.home.HomeFragment"
    android:label="@string/home_title"
    tools:layout="@layout/fragment_home" >

    <action
        android:id="@+id/action_home_to_detail"
        app:destination="@id/mealDetailFragment" />

</fragment>
<fragment
    android:id="@+id/mealDetailFragment"
    android:name="com.quickbite.app.ui.detail.MealDetailFragment"
    android:label="@string/home_title"
    tools:layout="@layout/fragment_detail" >

    <argument
        android:name="mealId"
        app:argType="string" />

</fragment>
<fragment
    android:id="@+id/favoritesFragment"
    android:name="com.quickbite.app.ui.favorites.FavoritesFragment"
    android:label="@string/favorites_title"
    tools:layout="@layout/fragment_favorites" >

    <action
        android:id="@+id/action_favorites_to_detail"
        app:destination="@id/mealDetailFragment" />

</fragment>
<fragment
    android:id="@+id/profileFragment"
    android:name="com.quickbite.app.ui.profile.ProfileFragment"
    android:label="@string/profile_title"
    tools:layout="@layout/fragment_profile" />
</navigation>